# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the populated file.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-64-byte-random-string

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated. Next.js dev server and the Flutter web target.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Matches docker-compose. Use the service name `db` when running inside compose.
DATABASE_URL=postgresql://lecturenote:lecturenote@localhost:5432/lecturenote
DB_ECHO=false

# Set true ONLY on a serverless host (Vercel functions). It swaps connection
# pooling for NullPool and disables prepared-statement caching, both of which
# are required behind a transaction pooler. Leave false for a long-running
# server; see DEPLOYMENT.md.
DB_SERVERLESS=false

# S3-compatible storage. These defaults match the bundled MinIO service.
# For Cloudflare R2 set S3_ENDPOINT_URL to your account endpoint.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=lecture-note

# Total file storage one classroom may use, in MB. Supabase's free tier is 1 GB
# for the whole project; this stops one class's slide decks from using it all.
CLASSROOM_STORAGE_LIMIT_MB=300

# --- AI: note generation ------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Without this, every note fails with "GEMINI_API_KEY is not set on the server".
GEMINI_API_KEY=
# Optional second key. Used automatically when the primary one is rate limited,
# which a single free-tier key reliably is during a busy day.
GEMINI_API_KEY_BACKUP=

# Model used for note generation. Google closes older models to new API keys,
# and a retired model 404s on the first call even though it still shows up in
# the model list. If notes start failing with "no longer available", set this to
# whatever Google's error message recommends.
GEMINI_MODEL=gemini-3.7-flash

# --- Email verification codes (Phase 5) -----------------------------------
# Gmail: create an App Password (Google Account → Security → App passwords);
# the normal account password will not work. Left empty outside production,
# codes are written to the server log instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# --- Face recognition (Phase 5, optional) ---------------------------------
# An HTTP service taking multipart `file` and returning {"embedding": [...]}.
# Students' photos are sent here, then discarded; only embeddings are stored.
# Choose it deliberately. Empty disables face enrolment.
FACE_EMBEDDING_URL=
FACE_EMBEDDING_API_KEY=
FACE_MODEL_VERSION=insightface
FACE_MATCH_THRESHOLD=0.5

# --- YouTube transcripts (Supadata) -------------------------------------
# Only needed for the "YouTube" note source. https://supadata.ai
SUPADATA_API_KEY=
SUPADATA_API_KEY_BACKUP=

# --- Push notifications (Phase 6, optional) -------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Either paste the JSON on one line or give the file's path.
# Empty: pushes are logged instead of sent. Schedule `python -m app.reminders`
# hourly for "due soon" reminders.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# How often clients poll a live quiz, in seconds.
QUIZ_POLL_INTERVAL_SECONDS=3
